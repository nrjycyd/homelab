{
  // ★ 模板文件：把所有 <...> 占位符替换为实际值后使用，清单见 README.md
  // sing-box v1.14.0 手机端配置（SFA / SFI 通用）
  // 分流参考 OxiDNS 瀑布流（DNS 与路由规则均自上而下、首条命中即停）：
  //  1  局域网(geosite private) 直连
  //  2a 自定义拒绝  2b 自定义代理  2c 自定义直连
  //  3  广告拒绝
  //  4  apple-cn 直连
  //  5  google-cn 直连
  //  6  geolocation-!cn 代理
  //  7  国内域(cn) 直连
  //  8  兜底 realip：解析后国内IP直连，否则代理
  //  非国内路径(2b/6) 禁 AAAA 记录（HTTPS 已由顶部全局拦截，即禁 v6）
  "$schema": "https://sing-box.sagernet.org/schema.json",

  "log": {
    "level": "info",
    "timestamp": true
  },

  "dns": {
    "servers": [
      // 引导 DNS：解析其他 DNS 服务器域名用（DoQ 直连阿里）
      {
        "type": "quic",
        "tag": "ali-dns",
        "server": "223.5.5.5",
        "server_port": 853
      },
      // 本地 DNS：使用手机系统默认 DNS（iOS 下=当前网络 DHCP DNS；在家即网关 DNS）
      {
        "type": "local",
        "tag": "local-dns"
      },
      // 国外 DNS（等价 OxiDNS forward_foreign，走代理）
      {
        "type": "https",
        "tag": "remote-dns",
        "server": "dns.google",
        "server_port": 443,
        "path": "/dns-query",
        "domain_resolver": {
          "server": "ali-dns",
          "strategy": "ipv4_only"
        },
        "detour": "proxy"
      }
    ],
    "rules": [
      {
        "query_type": ["SOA", "PTR", "HTTPS", "SVCB"],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "query_type": ["A", "AAAA"],
        "invert": true,
        "action": "reject"
      },
      // 1 局域网(private) 直连 → 本地 DNS
      {
        "rule_set": ["geosite-private"],
        "action": "route",
        "server": "local-dns"
      },
      // 2a 自定义拒绝 → NXDOMAIN
      {
        "rule_set": ["cusdom-reject"],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      // 2b 自定义代理 → 禁 v6 记录，走代理 DNS
      {
        "query_type": ["AAAA"],
        "rule_set": ["cusdom-proxy"],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "rule_set": ["cusdom-proxy"],
        "action": "route",
        "server": "remote-dns"
      },
      // 2c 自定义直连 → 本地 DNS
      {
        "rule_set": ["cusdom-direct"],
        "action": "route",
        "server": "local-dns"
      },
      // 3 广告 → NXDOMAIN
      {
        "rule_set": ["geosite-category-ads-all"],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      // 4 apple 国内可直连 → 本地 DNS
      {
        "rule_set": ["geosite-apple-cn"],
        "action": "route",
        "server": "local-dns"
      },
      // 5 google 国内可直连 → 本地 DNS
      {
        "rule_set": ["geosite-google-cn"],
        "action": "route",
        "server": "local-dns"
      },
      // 6 非国内域名 → 禁 v6 记录，走代理 DNS
      {
        "query_type": ["AAAA"],
        "rule_set": ["geosite-geolocation-!cn"],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "rule_set": ["geosite-geolocation-!cn"],
        "action": "route",
        "server": "remote-dns"
      },
      // 7 国内域 → 本地 DNS
      {
        "rule_set": ["geosite-cn"],
        "action": "route",
        "server": "local-dns"
      },
      // 8 兜底 realip：remote-dns 带国内 ECS 解析，命中 geoip-cn 直接返回（直连）
      {
        "action": "evaluate",
        "server": "remote-dns",
        "client_subnet": "<client-subnet-cidr>"
      },
      {
        "match_response": true,
        "rule_set": ["geoip-cn"],
        "action": "respond"
      },
      {
        "action": "respond"
      }
    ]
  },

  "http_clients": [
    // 规则集下载用 HTTP client（1.14 起需显式声明，替代被弃用的隐式默认 client）
    {
      "tag": "rule-set-download",
      "detour": "proxy"
    }
  ],

  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": ["172.18.0.1/30", "fdfe:dcba:9876::1/126"],
      "mtu": 9000,
      "dns_mode": "hijack",
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed"
    }
  ],

  "outbounds": [
    // 节点选择器（原 04_outbound.json 的 Proxy，tag 改小写以匹配路由规则；GLOBAL 已并入此选择器）
    {
      "tag": "proxy",
      "type": "selector",
      "outbounds": ["<node-1>", "<node-2>", "<node-3>"],
      "default": "<node-2>"
    },
    // 手动选择
    {
      "type": "selector",
      "tag": "select",
      "outbounds": ["proxy", "direct"]
    },
    // 局域网选择器，特判走 gh（默认 <gh-1>）
    {
      "tag": "gh",
      "type": "selector",
      "outbounds": ["<gh-1>", "<gh-2>"],
      "default": "<gh-1>"
    },
    // 测速（仅查看延迟，不参与任何路由决策）
    {
      "type": "urltest",
      "tag": "speed-proxy",
      "outbounds": ["proxy"],
      "url": "https://www.gstatic.com/generate_204"
    },
    {
      "type": "urltest",
      "tag": "speed-direct",
      "outbounds": ["direct"],
      "url": "https://www.baidu.com/generate_204"
    },
    {
      "type": "urltest",
      "tag": "speed-gh",
      "outbounds": ["gh"],
      "url": "https://www.baidu.com/generate_204"
    },
    // ==== 节点 1：<node-1>（hysteria2）====
    {
      "type": "hysteria2",
      "tag": "<node-1>",
      "server": "<node-1-server>",
      "server_ports": ["30000:50000"],
      "password": "<node-1-password>",
      "up_mbps": 50,
      "down_mbps": 100,
      "obfs": {
        "type": "salamander",
        "password": "<node-1-obfs-password>"
      },
      "tls": {
        "enabled": true,
        "disable_sni": false,
        "server_name": "<node-1-sni>",
        "insecure": false,
        "alpn": ["h3"],
        // 手机端改内联证书：把服务器 cert.crt 的内容粘贴到这里
        "certificate": [
          "<node-1-cert>"
        ]
      }
    },
    // ==== 节点 2：<node-2>（hysteria2）====
    {
      "type": "hysteria2",
      "tag": "<node-2>",
      "server": "<node-2-server>",
      "server_ports": ["30000:50000"],
      "password": "<node-2-password>",
      "up_mbps": 50,
      "down_mbps": 100,
      "obfs": {
        "type": "salamander",
        "password": "<node-2-obfs-password>"
      },
      "tls": {
        "enabled": true,
        "disable_sni": false,
        "server_name": "<node-2-sni>",
        "insecure": false,
        "alpn": ["h3"],
        // 手机端改内联证书：把服务器 cert.crt 的内容粘贴到这里
        "certificate": [
          "<node-2-cert>"
        ]
      }
    },
    // ==== 节点 3：<node-3>（vless）====
    {
      "type": "vless",
      "tag": "<node-3>",
      "server": "<node-3-server>",
      "server_port": 443,
      "uuid": "<node-3-uuid>",
      "flow": "xtls-rprx-vision",
      "packet_encoding": "xudp",
      "tls": {
        "enabled": true,
        "disable_sni": false,
        "server_name": "<node-3-sni>",
        "insecure": false,
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      }
    },
    // gh 节点：<gh-1>（hysteria2，局域网专用）
    {
      "type": "hysteria2",
      "tag": "<gh-1>",
      "server": "<gh-1-server>",
      "server_port": 17567,
      // 回家域名为纯 IPv6(AAAA)，默认解析策略 ipv4_only 会解析不到地址，这里显式覆盖
      "domain_resolver": {
        "server": "local-dns",
        "strategy": "ipv6_only"
      },
      "password": "<gh-1-password>",
      "up_mbps": 50,
      "down_mbps": 100,
      "tls": {
        "enabled": true,
        "disable_sni": false,
        "server_name": "<gh-1-sni>",
        "insecure": false,
        "alpn": ["h3"],
        // 手机端改内联证书：把服务器 cert.crt 的内容粘贴到这里
        "certificate": [
          "<gh-1-cert>"
        ]
      }
    },
    // gh 节点：<gh-2>（hysteria2，局域网专用）
    {
      "type": "hysteria2",
      "tag": "<gh-2>",
      "server": "<gh-2-server>",
      "server_port": 17569,
      // 回家域名为纯 IPv6(AAAA)，默认解析策略 ipv4_only 会解析不到地址，这里显式覆盖
      "domain_resolver": {
        "server": "local-dns",
        "strategy": "ipv6_only"
      },
      "password": "<gh-2-password>",
      "up_mbps": 50,
      "down_mbps": 100,
      "tls": {
        "enabled": true,
        "disable_sni": false,
        "server_name": "<gh-2-sni>",
        "insecure": false,
        "alpn": ["h3"],
        // 手机端改内联证书：把服务器 cert.crt 的内容粘贴到这里
        "certificate": [
          "<gh-2-cert>"
        ]
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],

  "route": {
    "rule_set": [
      { "type": "remote", "tag": "geosite-private", "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/private.srs",
        "update_interval": "24h" },
      { "type": "remote", "tag": "geosite-apple-cn", "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/apple-cn.srs",
        "update_interval": "24h" },
      { "type": "remote", "tag": "geosite-google-cn", "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/google-cn.srs",
        "update_interval": "24h" },
      { "type": "remote", "tag": "geosite-cn", "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/cn.srs",
        "update_interval": "24h" },
      { "type": "remote", "tag": "geosite-geolocation-!cn", "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/geolocation-!cn.srs",
        "update_interval": "24h" },
      { "type": "remote", "tag": "geosite-category-ads-all", "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ads-all.srs",
        "update_interval": "24h" },
      { "type": "remote", "tag": "geoip-cn", "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/cn.srs",
        "update_interval": "24h" },
      // 自定义内联域名集
      // "domain": ["reject.example.com"]
      // "domain_suffix": ["reject.example.com"]
      // "domain_keyword": ["reject"]
      // "domain_regex": ["^reject\\..+\\.com$"]
      // "domain" / "domain_suffix" / "domain_keyword" / "domain_regex" 规则可同时使用，满足任意一条即匹配
      // 自定义拒绝（内联）
      {
        "type": "inline",
        "tag": "cusdom-reject",
        "rules": [
          {
            "domain": ["<reject-domain>"],
            "domain_suffix": [],
            "domain_keyword": [],
            "domain_regex": []
          }
        ]
      },
      // 自定义代理（内联）
      {
        "type": "inline",
        "tag": "cusdom-proxy",
        "rules": [
          {
            "domain": ["<proxy-domain>"],
            "domain_suffix": [],
            "domain_keyword": [],
            "domain_regex": []
          }
        ]
      },
      // 自定义直连（内联）
      {
        "type": "inline",
        "tag": "cusdom-direct",
        "rules": [
          {
            "domain": ["<direct-domain>"],
            "domain_suffix": ["<direct-domain-suffix-1>", "<direct-domain-suffix-2>"],
            "domain_keyword": [],
            "domain_regex": []
          }
        ]
      }
    ],
    "rules": [
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      // 公共 DNS 走代理，防 DNS 泄漏
      {
        "ip_cidr": [
          "1.1.1.1/32", "1.0.0.1/32", "8.8.8.8/32", "8.8.4.4/32",
          "2001:4860:4860::8888/128", "2001:4860:4860::8844/128",
          "2606:4700:4700::1111/128", "2606:4700:4700::1001/128"
        ],
        "action": "route",
        "outbound": "proxy"
      },
      // 阿里 DNS 直连
      {
        "ip_cidr": ["223.5.5.5/32", "223.6.6.6/32"],
        "action": "route",
        "outbound": "direct"
      },
      // 拒 DoT / UDP443(QUIC) / STUN
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "port": 853 },
          { "network": "udp", "port": 443 },
          { "protocol": "stun" }
        ],
        "action": "reject",
        "method": "drop"
      },
      // 局域网 走 gh（特判）
      {
        "ip_cidr": ["10.0.0.0/24", "10.0.1.0/24"],
        "action": "route",
        "outbound": "gh"
      },
      // 1 局域网(private) → 直连
      {
        "rule_set": ["geosite-private"],
        "action": "route",
        "outbound": "direct"
      },
      // 2a 自定义拒绝 → 拦截
      {
        "rule_set": ["cusdom-reject"],
        "action": "reject"
      },
      // 2b 自定义代理 → 走代理
      {
        "rule_set": ["cusdom-proxy"],
        "action": "route",
        "outbound": "select"
      },
      // 2c 自定义直连 → 直连
      {
        "rule_set": ["cusdom-direct"],
        "action": "route",
        "outbound": "direct"
      },
      // 3 广告 → 拦截
      {
        "rule_set": ["geosite-category-ads-all"],
        "action": "reject"
      },
      // 4 apple 国内可直连 → 直连
      {
        "rule_set": ["geosite-apple-cn"],
        "action": "route",
        "outbound": "direct"
      },
      // 5 google 国内可直连 → 直连
      {
        "rule_set": ["geosite-google-cn"],
        "action": "route",
        "outbound": "direct"
      },
      // 6 非国内域名 → 走代理
      {
        "rule_set": ["geosite-geolocation-!cn"],
        "action": "route",
        "outbound": "select"
      },
      // 7 国内域 → 直连
      {
        "rule_set": ["geosite-cn"],
        "action": "route",
        "outbound": "direct"
      },
      // 8 兜底 realip：域名解析为 IP 后按 geoip-cn 分流
      { "action": "resolve" },
      {
        "rule_set": ["geoip-cn"],
        "action": "route",
        "outbound": "direct"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "ali-dns",
      "strategy": "ipv4_only"
    },
    "default_http_client": "rule-set-download",
    "final": "select"
  },

  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true
    }
  }
}